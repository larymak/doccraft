---
import '@/styles/tokens.css'
import '@/styles/global.css'
import { Header } from './Header'

export interface Props {
  title?: string
  description?: string
}

const {
  title = 'DocCraft',
  description = 'Master documentation systems through gamified learning.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Source+Code+Pro:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | DocCraft</title>
  </head>
  <body>
    <Header client:load />
    <main class="page-content">
      <slot />
    </main>
    <footer class="footer">
      <p>Built with the freeCodeCamp design system &middot; DocCraft</p>
    </footer>
  </body>
</html>

<style>
  body {
    margin: 0;
    background-color: var(--fcc-navy);
    color: var(--fcc-text-light);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .footer {
    background-color: var(--fcc-blue-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
    padding: var(--space-5) var(--space-4);
    font-size: var(--text-sm);
    color: var(--fcc-gray-400);
  }
</style>
