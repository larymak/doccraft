---
import PageLayout from '@/components/layout/PageLayout.astro'
import { ResultsPage } from '@/components/ResultsPage'
import { getAllMissions, getMissionBySlug, getUnit } from '@/lib/content-loader'
import { getAllUnits } from '@/lib/content-loader'

export async function getStaticPaths() {
  const missions = await getAllMissions()
  return missions.map(m => ({
    params: { slug: m.slug },
    props: { missionSlug: m.slug },
  }))
}

const { missionSlug } = Astro.props
const mission = await getMissionBySlug(missionSlug)
const unit = mission ? await getUnit(mission.unitId) : null

if (!mission || !unit) return Astro.redirect('/map')

const allMissions = await getAllMissions()
const allUnits = await getAllUnits()
---
<PageLayout title={`Results — ${mission.title}`}>
  <ResultsPage
    client:load
    missionId={mission.id}
    unitId={mission.unitId}
    unit={unit}
    mission={mission}
    allMissions={allMissions}
    allUnits={allUnits}
  />
</PageLayout>
