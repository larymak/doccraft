---
import PageLayout from '@/components/layout/PageLayout.astro'
---

<PageLayout title="DocCraft — Learn Documentation Systems">
  <div class="landing">

    <!-- ── Hero ── -->
    <section class="hero reveal">
      <div class="hero-badge">Free · No signup required · 37 missions</div>
      <h1 class="hero-title">DocCraft</h1>
      <p class="hero-tagline">
        The hands-on curriculum for learning documentation systems —<br />
        through real scenarios at a fictional tech company.
      </p>
      <div class="hero-actions">
        <a href="/onboarding" class="btn-primary" id="start-btn">Start Learning →</a>
        <a href="/map" class="btn-ghost" id="continue-btn" style="display:none">Continue Learning →</a>
      </div>
      <div class="hero-scroll-hint" aria-hidden>↓ scroll to learn more</div>
    </section>

    <!-- ── What is documentation? ── -->
    <section class="section reveal">
      <div class="section-eyebrow">The Foundation</div>
      <h2 class="section-title">What is documentation?</h2>
      <p class="section-lead">
        Documentation is how organizations capture what they know — so that knowledge survives people leaving, teams scaling, and time passing.
      </p>

      <div class="pillars">
        <div class="pillar reveal-child">
          <div class="pillar-icon" style="background: rgba(241,190,50,0.12); color: #f1be32;">📄</div>
          <strong>Writing</strong>
          <p>SOPs, tutorials, runbooks, how-to guides, ADRs — every document type has a specific job to do.</p>
        </div>
        <div class="pillar reveal-child">
          <div class="pillar-icon" style="background: rgba(59,130,246,0.12); color: #60a5fa;">🗂️</div>
          <strong>Architecture</strong>
          <p>Naming conventions, folder structures, and metadata so people can find what they need in under 30 seconds.</p>
        </div>
        <div class="pillar reveal-child">
          <div class="pillar-icon" style="background: rgba(16,185,129,0.12); color: #34d399;">⚙️</div>
          <strong>Docs-as-Code</strong>
          <p>Treating documentation like software — version control, pull requests, reviews, and automated checks.</p>
        </div>
        <div class="pillar reveal-child">
          <div class="pillar-icon" style="background: rgba(139,92,246,0.12); color: #a78bfa;">🏛️</div>
          <strong>Governance</strong>
          <p>Ownership models, review cadences, and maintenance systems that keep a knowledge base healthy as the org grows.</p>
        </div>
      </div>
    </section>

    <!-- ── Why it matters ── -->
    <section class="section reveal">
      <div class="section-eyebrow">The Problem</div>
      <h2 class="section-title">What happens without it</h2>

      <div class="cost-grid">
        <div class="cost-card reveal-child">
          <span class="cost-num">6–8 hrs</span>
          <p>The average engineer spends looking for information they should be able to find in minutes — every single week.</p>
        </div>
        <div class="cost-card reveal-child">
          <span class="cost-num">40%</span>
          <p>Of new hire ramp time is spent asking questions that should already be answered in the documentation.</p>
        </div>
        <div class="cost-card reveal-child">
          <span class="cost-num">#1</span>
          <p>Reason critical knowledge gets lost when a senior employee leaves — and nobody documented what they knew.</p>
        </div>
      </div>
    </section>

    <!-- ── Careers ── -->
    <section class="section reveal">
      <div class="section-eyebrow">Career Paths</div>
      <h2 class="section-title">Where this takes you</h2>
      <p class="section-lead">Documentation skills are in demand across multiple growing career paths.</p>

      <div class="careers">
        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">✍️</span>
            <div>
              <strong class="career-title">Technical Writer</strong>
              <span class="career-level">Entry → Senior → Staff</span>
            </div>
          </div>
          <p>Creates product documentation, API guides, and user manuals. Works closely with engineering and product teams to translate technical complexity into clear language.</p>
          <div class="career-skills">
            <span>Writing</span><span>Research</span><span>Product</span>
          </div>
        </div>

        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">⚙️</span>
            <div>
              <strong class="career-title">Documentation Engineer</strong>
              <span class="career-level">Mid → Senior → Principal</span>
            </div>
          </div>
          <p>Builds the infrastructure for documentation — docs-as-code pipelines, static site generators, linters, and automated quality checks. Lives at the intersection of writing and engineering.</p>
          <div class="career-skills">
            <span>Git</span><span>Automation</span><span>Tooling</span>
          </div>
        </div>

        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">📢</span>
            <div>
              <strong class="career-title">Developer Advocate</strong>
              <span class="career-level">Mid → Senior → Lead</span>
            </div>
          </div>
          <p>Creates tutorials, sample code, and educational content for developer communities. Documentation quality directly determines how fast developers adopt the platform.</p>
          <div class="career-skills">
            <span>Tutorials</span><span>Community</span><span>APIs</span>
          </div>
        </div>

        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">🗺️</span>
            <div>
              <strong class="career-title">Knowledge Manager</strong>
              <span class="career-level">Mid → Senior → Director</span>
            </div>
          </div>
          <p>Owns the health of an organization's entire knowledge base — governance policies, ownership models, tooling decisions, and the systems that keep documentation from going stale.</p>
          <div class="career-skills">
            <span>Governance</span><span>Strategy</span><span>Systems</span>
          </div>
        </div>

        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">🎯</span>
            <div>
              <strong class="career-title">Content Strategist</strong>
              <span class="career-level">Mid → Senior → VP</span>
            </div>
          </div>
          <p>Plans and governs content at scale — information architecture, style guides, content taxonomies, and the standards that make an entire documentation ecosystem coherent.</p>
          <div class="career-skills">
            <span>Strategy</span><span>IA</span><span>Standards</span>
          </div>
        </div>

        <div class="career-card reveal-child">
          <div class="career-header">
            <span class="career-icon">🔍</span>
            <div>
              <strong class="career-title">Any Engineering Role</strong>
              <span class="career-level">Junior → Senior → Staff</span>
            </div>
          </div>
          <p>Engineers who can document their own systems clearly are consistently rated more effective by their teams — and move faster through promotion cycles because their impact is visible.</p>
          <div class="career-skills">
            <span>Runbooks</span><span>ADRs</span><span>Onboarding</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Curriculum tiers ── -->
    <section class="section reveal">
      <div class="section-eyebrow">The Curriculum</div>
      <h2 class="section-title">From beginner to pro</h2>
      <p class="section-lead">10 units, 37 missions, one fictional company. You start on day one as a new documentation specialist and work your way up.</p>

      <div class="tier-grid">
        <div class="tier-card reveal-child">
          <div class="tier-top">
            <span class="tier-emoji">🌱</span>
            <div>
              <strong>Beginner</strong>
              <span class="tier-label">Units 1–2</span>
            </div>
          </div>
          <p>Understand knowledge debt, the 8 document types, and how to choose the right one for any situation.</p>
          <div class="tier-unlocks">Always available</div>
        </div>
        <div class="tier-card reveal-child">
          <div class="tier-top">
            <span class="tier-emoji">🔧</span>
            <div>
              <strong>Intermediate</strong>
              <span class="tier-label">Units 3–5</span>
            </div>
          </div>
          <p>Write for a specific audience, design reusable templates, and create naming conventions that scale.</p>
          <div class="tier-unlocks">Unlocks after Beginner</div>
        </div>
        <div class="tier-card reveal-child">
          <div class="tier-top">
            <span class="tier-emoji">⚡</span>
            <div>
              <strong>Advanced</strong>
              <span class="tier-label">Units 6–8</span>
            </div>
          </div>
          <p>Master searchability and metadata, work in a simulated Git docs-as-code environment, and design governance models.</p>
          <div class="tier-unlocks">Unlocks after Intermediate</div>
        </div>
        <div class="tier-card tier-card--pro reveal-child">
          <div class="tier-top">
            <span class="tier-emoji">🏆</span>
            <div>
              <strong>Pro</strong>
              <span class="tier-label">Units 9–10</span>
            </div>
          </div>
          <p>Capture architectural decisions, preserve institutional memory, and complete a full crisis knowledge-transfer operation.</p>
          <div class="tier-unlocks">Unlocks after Advanced</div>
        </div>
      </div>
    </section>

    <!-- ── How it works ── -->
    <section class="section reveal">
      <div class="section-eyebrow">Gameplay</div>
      <h2 class="section-title">How the missions work</h2>

      <div class="steps">
        <div class="step reveal-child">
          <div class="step-vis">
            <div class="step-num">1</div>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <strong>Read the scenario</strong>
            <p>You are a new documentation specialist at Northstar Apps. Every mission starts with a real situation — Jordan, your manager, briefs you on the problem.</p>
          </div>
        </div>
        <div class="step reveal-child">
          <div class="step-vis">
            <div class="step-num">2</div>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <strong>Review the materials</strong>
            <p>Most missions include actual documents you can read — messy wiki pages, outdated SOPs, Slack logs, deployment guides — the kind of thing you'd find in a real company.</p>
          </div>
        </div>
        <div class="step reveal-child">
          <div class="step-vis">
            <div class="step-num">3</div>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <strong>Complete the tasks</strong>
            <p>Sort documents, answer multiple-choice questions, write short plans. Every task teaches one concrete skill and gives instant feedback.</p>
          </div>
        </div>
        <div class="step reveal-child">
          <div class="step-vis">
            <div class="step-num">4</div>
          </div>
          <div class="step-body">
            <strong>Earn XP, reduce debt, unlock badges</strong>
            <p>Each completed mission chips away at Northstar Apps' knowledge debt meter and earns you experience points and badges. Complete a tier's boss mission to unlock the next level.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Bottom CTA ── -->
    <section class="cta reveal">
      <div class="cta-inner">
        <span class="cta-emoji">🎯</span>
        <h2 class="cta-title">Start your first mission</h2>
        <p class="cta-sub">No account required. Picks up where you left off automatically.</p>
        <a href="/onboarding" class="btn-primary btn-lg" id="cta-start-btn">Start Learning Free →</a>
      </div>
    </section>

  </div>
</PageLayout>

<script>
  // Returning users see "Continue" buttons
  const hasProgress = !!localStorage.getItem('doccraft_progress')
  if (hasProgress) {
    const startBtn = document.getElementById('start-btn')
    const continueBtn = document.getElementById('continue-btn')
    const ctaBtn = document.getElementById('cta-start-btn')
    if (startBtn) startBtn.style.display = 'none'
    if (continueBtn) continueBtn.style.display = 'inline-flex'
    if (ctaBtn) { ctaBtn.textContent = 'Continue Learning →'; ctaBtn.setAttribute('href', '/map') }
  }

  // Scroll-reveal
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target) } }),
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  )
  document.querySelectorAll('.reveal, .reveal-child').forEach(el => observer.observe(el))
</script>

<style>
  /* ── Layout ── */
  .landing {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-20);
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  /* ── Reveal animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal-child {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .reveal.visible, .reveal-child.visible { opacity: 1; transform: translateY(0); }

  /* Stagger children */
  .pillars .reveal-child:nth-child(1) { transition-delay: 0ms; }
  .pillars .reveal-child:nth-child(2) { transition-delay: 80ms; }
  .pillars .reveal-child:nth-child(3) { transition-delay: 160ms; }
  .pillars .reveal-child:nth-child(4) { transition-delay: 240ms; }
  .cost-grid .reveal-child:nth-child(1) { transition-delay: 0ms; }
  .cost-grid .reveal-child:nth-child(2) { transition-delay: 100ms; }
  .cost-grid .reveal-child:nth-child(3) { transition-delay: 200ms; }
  .careers .reveal-child:nth-child(n) { transition-delay: calc(var(--i, 0) * 70ms); }
  .tier-grid .reveal-child:nth-child(1) { transition-delay: 0ms; }
  .tier-grid .reveal-child:nth-child(2) { transition-delay: 90ms; }
  .tier-grid .reveal-child:nth-child(3) { transition-delay: 180ms; }
  .tier-grid .reveal-child:nth-child(4) { transition-delay: 270ms; }
  .steps .reveal-child:nth-child(1) { transition-delay: 0ms; }
  .steps .reveal-child:nth-child(2) { transition-delay: 100ms; }
  .steps .reveal-child:nth-child(3) { transition-delay: 200ms; }
  .steps .reveal-child:nth-child(4) { transition-delay: 300ms; }

  /* ── Hero ── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-16) 0 var(--space-4);
    gap: var(--space-4);
  }

  .hero-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fcc-gold);
    background: rgba(241, 190, 50, 0.12);
    border: 1px solid rgba(241, 190, 50, 0.3);
    border-radius: var(--radius-full);
    padding: 4px var(--space-3);
  }

  .hero-title {
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 900;
    color: var(--fcc-text-light);
    margin: 0;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 40%, var(--fcc-gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--fcc-gray-300);
    line-height: 1.7;
    margin: 0;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .hero-scroll-hint {
    margin-top: var(--space-8);
    font-size: var(--text-xs);
    color: var(--fcc-gray-600);
    letter-spacing: 0.05em;
    animation: scrollBounce 2s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: var(--fcc-gold);
    color: var(--fcc-navy);
    font-size: var(--text-base);
    font-weight: 800;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }

  .btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }

  .btn-primary.btn-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: transparent;
    color: var(--fcc-text-light);
    font-size: var(--text-base);
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-ghost:hover { border-color: var(--fcc-gold); color: var(--fcc-gold); }

  /* ── Sections ── */
  .section { display: flex; flex-direction: column; gap: var(--space-6); }

  .section-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fcc-gold);
  }

  .section-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-weight: 900;
    color: var(--fcc-text-light);
    margin: 0;
    line-height: 1.2;
  }

  .section-lead {
    font-size: var(--text-base);
    color: var(--fcc-gray-300);
    line-height: 1.7;
    margin: 0;
    max-width: 680px;
  }

  /* ── Pillars ── */
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .pillar {
    background: var(--fcc-blue-dark);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .pillar strong {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--fcc-text-light);
  }

  .pillar p {
    font-size: var(--text-sm);
    color: var(--fcc-gray-400);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Cost cards ── */
  .cost-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .cost-card {
    background: linear-gradient(135deg, var(--fcc-blue-dark), rgba(241,190,50,0.04));
    border: 1px solid rgba(241, 190, 50, 0.15);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cost-num {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--fcc-gold);
    line-height: 1;
  }

  .cost-card p {
    font-size: var(--text-sm);
    color: var(--fcc-gray-300);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Careers ── */
  .careers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .career-card {
    background: var(--fcc-blue-dark);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.2s, transform 0.2s;
  }

  .career-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .career-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .career-icon {
    font-size: 28px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .career-title {
    display: block;
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--fcc-text-light);
    line-height: 1.3;
  }

  .career-level {
    display: block;
    font-size: var(--text-xs);
    color: var(--fcc-gold);
    font-weight: 600;
    margin-top: 2px;
  }

  .career-card p {
    font-size: var(--text-sm);
    color: var(--fcc-gray-400);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .career-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .career-skills span {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--fcc-gray-300);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 2px var(--space-2);
  }

  /* ── Tier grid ── */
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .tier-card {
    background: var(--fcc-blue-dark);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tier-card--pro {
    border-color: rgba(241, 190, 50, 0.25);
    background: linear-gradient(135deg, var(--fcc-blue-dark) 60%, rgba(241, 190, 50, 0.05));
  }

  .tier-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tier-emoji { font-size: var(--text-2xl); line-height: 1; }

  .tier-top strong {
    display: block;
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--fcc-text-light);
  }

  .tier-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--fcc-gray-400);
    margin-top: 2px;
  }

  .tier-card p {
    font-size: var(--text-sm);
    color: var(--fcc-gray-400);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .tier-unlocks {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--fcc-gold);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  /* ── How it works ── */
  .steps {
    display: flex;
